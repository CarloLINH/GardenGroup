@model IEnumerable<GardenGroup.Models.Ticket>
@using GardenGroup.Extensions
@using GardenGroup.Enums
@{
    // Author: Mart
    // One list for both roles. The controller already limits a regular employee to their own tickets;
    // the view only hides what that role cannot use (assignee filter, Edit, Delete).
    var isServiceDesk = User.IsServiceDesk();
    var isSearching = !string.IsNullOrWhiteSpace((string?)ViewBag.Search);
    var sort = (string)ViewBag.Sort;
    ViewData["Title"] = isServiceDesk ? "All tickets" : "My tickets";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="m-0 fw-bold text-dark">@(isServiceDesk ? "All tickets" : "My tickets")</h2>
            <p class="text-muted mb-0">
                @(isServiceDesk ? "Manage and track all support requests" : "Follow the progress of the incidents you reported")
            </p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            + Create New Ticket
        </a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-12">
            <input type="search" name="q" class="form-control" maxlength="100"
                   placeholder="Search in title and description, e.g. printer AND offline OR wifi"
                   value="@ViewBag.Search" />
            <div class="form-text">
                Words are combined with AND. Write OR (capitals) for an alternative. Search results are shown newest first.
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var s in Enum.GetValues<Statuses>())
                {
                    <option value="@s" selected="@((Statuses?)ViewBag.Status == s)">@s.ToLabel()</option>
                }
            </select>
        </div>
        @if (isServiceDesk)
        {
            <div class="col-md-3">
                <input type="number" name="assignedTo" class="form-control" placeholder="Assigned to (employee id)" value="@ViewBag.AssignedTo" />
            </div>
        }
        <div class="col-md-3">
            <select name="sort" class="form-select">
                <option value="@TicketSort.Newest" selected="@(sort == TicketSort.Newest)">Newest first</option>
                <option value="@TicketSort.Oldest" selected="@(sort == TicketSort.Oldest)">Oldest first</option>
                <option value="@TicketSort.PriorityDesc" selected="@(sort == TicketSort.PriorityDesc)">Priority: high to low</option>
                <option value="@TicketSort.PriorityAsc" selected="@(sort == TicketSort.PriorityAsc)">Priority: low to high</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    @if (isSearching)
                    {
                        <h5 class="text-muted fw-normal">No tickets match your search.</h5>
                        <p class="text-muted mb-0">Try other words, or use OR to widen the search.</p>
                    }
                    else
                    {
                        <h5 class="text-muted fw-normal">No tickets found.</h5>
                        <p class="text-muted mb-0">
                            @(isServiceDesk ? "Change the filters or create a ticket." : "You have not reported a ticket yet. Click the button above to create one.")
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="thead-dark">
                            <tr>
                                <th class="text-secondary fw-semibold py-3 ps-4">Ticket ID</th>
                                <th class="text-secondary fw-semibold py-3">Title</th>
                                <th class="text-secondary fw-semibold py-3">Status</th>
                                <th class="text-secondary fw-semibold py-3">Priority</th>
                                <th class="text-secondary fw-semibold py-3">Created At</th>
                                <th class="text-secondary fw-semibold py-3 pe-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted fw-bold">#@item.TicketId</td>
                                    <td class="fw-medium text-dark">@item.Title</td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 @item.Status.GetBadgeColor()">
                                            @item.Status.ToLabel()
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 @item.Priority.GetPriorityClass()">
                                            @item.Priority
                                        </span>
                                    </td>
                                    <td class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="pe-4 text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary px-3">Details</a>
                                        @if (isServiceDesk)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary ms-2 px-3">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-2 px-3">Delete</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if ((bool)ViewBag.Paged)
            {
                var page = (int)ViewBag.Page;
                <div class="d-flex justify-content-between p-3">
                    @if (page > 0)
                    {
                        <a asp-action="Index" asp-route-q="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-assignedTo="@ViewBag.AssignedTo"
                           asp-route-sort="@ViewBag.Sort" asp-route-page="@(page - 1)" class="btn btn-sm btn-outline-secondary">Previous</a>
                    }
                    else
                    {
                        <span></span>
                    }
                    @if ((bool)ViewBag.HasNext)
                    {
                        <a asp-action="Index" asp-route-q="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-assignedTo="@ViewBag.AssignedTo"
                           asp-route-sort="@ViewBag.Sort" asp-route-page="@(page + 1)" class="btn btn-sm btn-outline-secondary">Next</a>
                    }
                </div>
            }
        </div>
    </div>
</div>