@model IEnumerable<GardenGroup.Models.Ticket>
@using GardenGroup.Extensions

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="m-0 fw-bold text-dark">Ticket Dashboard</h2>
            <p class="text-muted mb-0">Manage and track your support requests</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            + Create New Ticket
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5 class="text-muted fw-normal">No tickets found.</h5>
                    <p class="text-muted mb-0">Click the button above to create your first ticket.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="thead-dark">
                            <tr>
                                <th class="text-secondary fw-semibold py-3 ps-4">Ticket ID</th>
                                <th class="text-secondary fw-semibold py-3">Title</th>
                                <th class="text-secondary fw-semibold py-3">Status</th>
                                <th class="text-secondary fw-semibold py-3">Priority</th>
                                <th class="text-secondary fw-semibold py-3">Created At</th>
                                <th class="text-secondary fw-semibold py-3 pe-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var item in Model)
                            {
                                
                                <tr>
                                    <td class="ps-4 text-muted fw-bold">#@item.TicketId</td>
                                    <td class="fw-medium text-dark">@item.Title</td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 @item.Status.GetBadgeColor()">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 @item.Priority.GetPriorityClass()">
                                            @item.Priority
                                        </span>
                                    </td>
                                    <td class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="pe-4 text-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2 px-3">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>