@using GardenGroup.Extensions
@model GardenGroup.Models.Ticket
@{
    ViewData["Title"] = $"Delete ticket #{Model.TicketId}";
}

<div class="gg-page-header">
    <div>
        <h1>Delete ticket #@Model.TicketId</h1>
        <p>This cannot be undone.</p>
    </div>
</div>

<div class="gg-card gg-form">
    <div class="alert alert-danger">
        Are you sure you want to permanently delete this ticket?
    </div>

    <dl class="gg-details row">
        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge rounded-pill px-3 py-2 @Model.Status.GetBadgeColor()">@Model.Status.ToLabel()</span>
        </dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9 gg-pre">@Model.Description</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="gg-actions">
        <button type="submit" class="btn btn-danger">Yes, delete ticket</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">No, go back</a>
    </form>
</div>
