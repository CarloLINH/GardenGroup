@using GardenGroup.Enums
@using GardenGroup.Extensions
@using GardenGroup.Services
@model GardenGroup.ViewModels.TicketDetails
@{
    var isServiceDesk = User.IsServiceDesk();
    var isOverdue = Model.Deadline is { } d && d.Date < DateTime.Today
                    && Model.Status is not (Statuses.Closed or Statuses.Resolved);
    ViewData["Title"] = $"Ticket #{Model.TicketId}";
}

<div class="gg-page-header">
    <div>
        <h1>Ticket #@Model.TicketId</h1>
        <p>@Model.Title</p>
    </div>
    <div class="gg-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
        @if (isServiceDesk)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
            @if (TicketEscalator.CanEscalate(Model.Status))
            {
                <form asp-action="Escalate" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Send this ticket to management?');">
                    <button type="submit" class="btn btn-warning">Escalate</button>
                </form>
            }
            @if (TicketEscalator.CanClose(Model.Status))
            {
                <form asp-action="Close" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Close this ticket?');">
                    <button type="submit" class="btn btn-secondary">Close</button>
                </form>
            }
            <a asp-action="Transfer" asp-route-id="@Model.Id" class="btn btn-primary"> Transfer ticket </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        }
    </div>
</div>

<div class="gg-card">
    <dl class="gg-details row mb-0">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge rounded-pill px-3 py-2 @Model.Status.GetBadgeColor()">@Model.Status.ToLabel()</span>
        </dd>

        <dt class="col-sm-3">Priority</dt>
        <dd class="col-sm-9">
            <span class="badge rounded-pill px-3 py-2 @Model.Priority.GetPriorityClass()">@Model.Priority</span>
        </dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.Type</dd>

        <dt class="col-sm-3">Deadline</dt>
        <dd class="col-sm-9">
            @if (Model.Deadline is null)
            {
                <span class="text-muted">No deadline</span>
            }
            else
            {
                <span>@Model.Deadline.Value.ToString("MMM dd, yyyy")</span>
                @if (isOverdue)
                {
                    <span class="badge text-bg-danger ms-2">Overdue</span>
                }
            }
        </dd>

        <dt class="col-sm-3">Reported by</dt>
        <dd class="col-sm-9">
            @(Model.Reporter is null ? "Unknown employee" : $"{Model.Reporter.FirstName} {Model.Reporter.LastName}")
        </dd>

        <dt class="col-sm-3">Assigned to</dt>
        <dd class="col-sm-9">
            @(Model.Assignee is null ? "Unassigned" : $"{Model.Assignee.FirstName} {Model.Assignee.LastName}")
        </dd>

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>

        @if (Model.EscalatedAt is not null)
        {
            <dt class="col-sm-3">Escalated</dt>
            <dd class="col-sm-9">@Model.EscalatedAt.Value.ToString("MMM dd, yyyy HH:mm")</dd>
        }
        @if (Model.ClosedAt is not null)
        {
            <dt class="col-sm-3">Closed</dt>
            <dd class="col-sm-9">@Model.ClosedAt.Value.ToString("MMM dd, yyyy HH:mm")</dd>
        }

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9 gg-pre">@Model.Description</dd>
    </dl>
</div>