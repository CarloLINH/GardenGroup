@using GardenGroup.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@model GardenGroup.Models.Ticket
@{
    // Author: Emre. Service Desk only (the controller has the ServiceDesk policy).
    ViewData["Title"] = $"Edit ticket #{Model.TicketId}";
}

<div class="gg-page-header">
    <div>
        <h1>Edit ticket #@Model.TicketId</h1>
        <p>Change the status, assignee or details of this ticket.</p>
    </div>
</div>

<div class="gg-card gg-form">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<Statuses>()" class="form-select"></select>
                <span asp-validation-for="Status"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="AssignedToId" class="form-label"></label>
                <select asp-for="AssignedToId" asp-items="(List<SelectListItem>)ViewBag.Assignees" class="form-select">
                    <option value="">Unassigned</option>
                </select>
                <span asp-validation-for="AssignedToId"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Subject</label>
            <input asp-for="Title" class="form-control" maxlength="100" />
            <span asp-validation-for="Title"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000"></textarea>
            <span asp-validation-for="Description"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<TicketTypes>()" class="form-select"></select>
                <span asp-validation-for="Type"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priorities>()" class="form-select"></select>
                <span asp-validation-for="Priority"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Deadline" class="form-label"></label>
            <input asp-for="Deadline" type="date" class="form-control" />
            <span asp-validation-for="Deadline"></span>
        </div>

        <div class="gg-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
