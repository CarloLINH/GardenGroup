@{
	ViewData["Title"] = "Password reset requested";
}
<h1>Password reset requested</h1>
<p>If the account exists, a reset link has been generated. In this deployment the link is shown below for the configured mail integration to deliver.</p>
@if (TempData["ResetLink"] is string resetLink)
{
	<p><a href="@resetLink">Continue to reset password</a></p>
}
<a asp-action="Login">Back to login</a>