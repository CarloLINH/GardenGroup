@model Employee

@{
	ViewData["Title"] = "Employee details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1>Employee details</h1>
	<div>
		<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
		@if (Model.Active)
		{
			<a asp-action="Deactivate" asp-route-id="@Model.Id" class="btn btn-outline-danger">Deactivate</a>
		}
	</div>
</div>

<dl class="row">
	<dt class="col-sm-3">Employee ID</dt>
	<dd class="col-sm-9">@Model.EmployeeId</dd>
	<dt class="col-sm-3">Name</dt>
	<dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>
	<dt class="col-sm-3">Email</dt>
	<dd class="col-sm-9">@Model.Email</dd>
	<dt class="col-sm-3">Role</dt>
	<dd class="col-sm-9">@Model.Role</dd>
	<dt class="col-sm-3">Status</dt>
	<dd class="col-sm-9">@(Model.Active ? "Active" : "Inactive")</dd>
</dl>

<a asp-action="Index" class="btn btn-outline-secondary">Back to employees</a>
