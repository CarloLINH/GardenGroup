@model IEnumerable<Employee>

@{
	ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1>Employees</h1>
	<a asp-action="Create" class="btn btn-primary">Register employee</a>
</div>

@if (!Model.Any())
{
	<p>No employees have been registered yet.</p>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped align-middle">
			<thead>
				<tr>
					<th>ID</th>
					<th>Name</th>
					<th>Email</th>
					<th>Role</th>
					<th>Status</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
			@foreach (var employee in Model)
			{
				<tr>
					<td>@employee.EmployeeId</td>
					<td>@employee.FirstName @employee.LastName</td>
					<td>@employee.Email</td>
					<td>@employee.Role</td>
					<td>
						@if (employee.Active)
						{
							<span class="badge text-bg-success">Active</span>
						}
						else
						{
							<span class="badge text-bg-secondary">Inactive</span>
						}
					</td>
					<td class="text-end">
						<a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary">Details</a>
						<a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">Edit</a>
						@if (employee.Active)
						{
							<a asp-action="Deactivate" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger">Deactivate</a>
						}
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
}
