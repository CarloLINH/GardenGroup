@using System.Globalization
@using GardenGroup.Enums
@model GardenGroup.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    // Numbers in CSS need a dot (12.5), even if the page runs in Dutch (12,5).
    string Css(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    string Label(TicketCategory c) => c switch
    {
        TicketCategory.Open => "Open",
        TicketCategory.Resolved => "Resolved",
        _ => "Closed without resolve"
    };

    string Mod(TicketCategory c) => c switch
    {
        TicketCategory.Open => "is-open",
        TicketCategory.Resolved => "is-resolved",
        _ => "is-closed"
    };

    var total = Model.Total;
    var summary = string.Join(", ", Model.Categories.Select(c => $"{Label(c.Category)}: {c.Percentage:0.#}%"));
    var maxWork = Model.Workloads.Any() ? Model.Workloads.Max(w => w.TicketCount) : 1;
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="dash">
    <header class="dash-head">
        <h1>@(Model.IsPersonal ? "Your tickets at a glance" : "Status of all tickets")</h1>
        <p>@(total == 1 ? "1 ticket" : $"{total} tickets") in total</p>
    </header>

    @if (total == 0)
    {
        <div class="dash-empty">
            <p class="dash-empty-title">
                @(Model.IsPersonal ? "You have no tickets yet." : "There are no tickets yet.")
            </p>
            <p>
                @(Model.IsPersonal
                    ? "Once you report an incident, you will see how it is going here."
                    : "Once tickets are created, the current status will appear here.")
            </p>
            <a class="btn btn-outline-secondary" asp-controller="Ticket" asp-action="Index">Go to tickets</a>
        </div>
    }
    else
    {
        <div class="dist" role="img" aria-label="Distribution of tickets. @summary">
            @foreach (var c in Model.Categories.Where(c => c.Count > 0))
            {
                <div class="dist-seg @Mod(c.Category)"
                     style="width:@Css(100.0 * c.Count / total)%"
                     title="@Label(c.Category): @c.Count"></div>
            }
        </div>

        <div class="stats">
            @foreach (var c in Model.Categories)
            {
                <div class="stat @Mod(c.Category)">
                    <div class="stat-value">@c.Percentage.ToString("0.#")%</div>
                    <div class="stat-label">@Label(c.Category)</div>
                    <div class="stat-count">@(c.Count == 1 ? "1 ticket" : $"{c.Count} tickets")</div>
                </div>
            }
        </div>
    }

    @if (!Model.IsPersonal)
    {
        <section class="work">
            <h2>Workload</h2>
            @if (!Model.Workloads.Any())
            {
                <p class="text-muted">No tickets have been assigned yet.</p>
            }
            else
            {
                @foreach (var w in Model.Workloads)
                {
                    <div class="work-row">
                        <div class="work-name">@w.Name</div>
                        <div class="work-bar" aria-hidden="true">
                            <span style="width:@Css(100.0 * w.TicketCount / maxWork)%"></span>
                        </div>
                        <div class="work-num">@w.TicketCount</div>
                    </div>
                }
            }
        </section>
    }
</div>